# Скопируйте в .env и заполните. Файл .env не коммитится.

# Токен бота из Discord Developer Portal. Имя переменной историческое:
# main это токен рабочего бота, test это запасной.
main=
test=

# Токен Telegram-бота из @BotFather. Пустое значение выключает Telegram,
# Discord продолжает работать.
TELEGRAM_TOKEN=

# Необязательный числовой id чата для прогрева inline-кэша: бот один раз
# отправит туда мемы и запомнит file_id. Без него inline-режим наполняется
# после первого /meme <имя>.
TG_CACHE_CHAT=

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432
DB_NAME=batekbot
