# Alpine-вариант Rust-версии бота. Контекст сборки это корень репозитория:
#     docker build --network=host -f rust/Dockerfile.alpine -t batekbot-rust:alpine .
#
# Почему отдельный файл: Debian остаётся рабочим вариантом, Alpine проверяется
# как эксперимент. Бинарник здесь собирается под musl (rust:1-alpine сам
# musl-based), поэтому C-зависимости (opus через cmake, ring) собираются в
# build-base, а yt-dlp берётся из официальной musl-сборки.

FROM rust:1-alpine AS builder
WORKDIR /build
RUN apk add --no-cache build-base cmake pkgconf linux-headers perl

COPY rust/Cargo.toml rust/Cargo.lock ./
# Зависимости собираются отдельным слоем: правка кода не инвалидирует их.
# Без заглушки cargo fetch падает, потому что в манифесте нет цели.
RUN mkdir -p src && printf 'fn main() {}\n' > src/main.rs \
    && cargo fetch --locked \
    && cargo build --release

# Настоящий код заменяет заглушку: cargo пересобирает только этот крейт.
COPY rust/migrations ./migrations
COPY rust/src ./src
COPY rust/tests ./tests
# COPY сохраняет mtime файлов, а заглушка собрана позже них. Без touch cargo
# считает пакет свежим и молча не пересобирает.
RUN touch src/main.rs && cargo build --release

# Рантайм: alpine + самодостаточный yt-dlp под musl.
FROM alpine:3.22

ARG YTDLP_VERSION=2026.10.26
RUN apk add --no-cache ca-certificates curl \
    && curl -fsSL -o /usr/local/bin/yt-dlp \
       "https://github.com/yt-dlp/yt-dlp/releases/download/${YTDLP_VERSION}/yt-dlp_musllinux" \
    && chmod 0755 /usr/local/bin/yt-dlp \
    && apk del curl \
    && addgroup -g 10001 batek \
    && adduser -S -D -H -u 10001 -G batek -h /app batek

WORKDIR /app
RUN chown batek:batek /app
COPY --from=builder /build/target/release/batekbot /usr/local/bin/batekbot
COPY --chown=batek:batek music/ /app/music/
COPY --chown=batek:batek video/ /app/video/

ENV BATEK_ROOT=/app
USER batek
ENTRYPOINT ["batekbot"]
